[Unit]
Description=Spin down the backup disk after it is idle
After=local-fs.target

[Service]
Type=simple
Environment=PYTHONPATH=/opt/immich-backup
WorkingDirectory=/opt/immich-backup
ExecStart=/usr/bin/python3 -m immich_backup spindown --config /etc/immich-backup/config.ini
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
